# Port the API listens on
PORT=4000

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/revenue_dashboard

# Secret used to sign admin session tokens. Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Origin of the Next.js app (only needed if the browser calls the API directly)
CORS_ORIGIN=http://localhost:3000

# Admin account created/updated by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Admin

# Session cookie "Secure" flag. Defaults to true when NODE_ENV=production; set false to use production mode over plain http.
# COOKIE_SECURE=false
